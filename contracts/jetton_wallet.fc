;; ============================================
;; TEP-74 Jetton Wallet Contract
;; Clean & Working version
;; FunC 0.4.6 compatible
;; ============================================

#include "imports/stdlib.fc";

const int op::transfer = 0xf8a7ea5;
const int op::internal_transfer = 0x178d4519;
const int op::transfer_notification = 0x7362d09c;
const int op::burn = 0x595f07bc;
const int op::burn_notification = 0x7bdd97de;

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }

    slice sender_address = cs~load_msg_addr();

    slice ds = get_data().begin_parse();
    int balance = ds~load_coins();
    slice owner_address = ds~load_msg_addr();
    slice jetton_master_address = ds~load_msg_addr();
    cell jetton_wallet_code = ds~load_ref();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == op::internal_transfer) {
        int amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();
        slice response_address = in_msg_body~load_msg_addr();
        int forward_ton_amount = in_msg_body~load_coins();

        slice expected_sender = begin_cell()
            .store_uint(0, 2)
            .store_slice(from_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .end_cell()
            .begin_parse();

        throw_unless(401,
            (slice_hash(sender_address) == slice_hash(jetton_master_address)) |
            (slice_hash(sender_address) == slice_hash(expected_sender))
        );

        balance = balance + amount;

        set_data(begin_cell()
            .store_coins(balance)
            .store_slice(owner_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .end_cell());

        if (forward_ton_amount > 0) {
            cell notification_body = begin_cell()
                .store_uint(op::transfer_notification, 32)
                .store_uint(query_id, 64)
                .store_coins(amount)
                .store_slice(from_address)
                .store_uint(0, 1)
                .end_cell();

            send_raw_message(begin_cell()
                .store_uint(0x18, 6)
                .store_slice(owner_address)
                .store_coins(forward_ton_amount)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
                .store_ref(notification_body)
                .end_cell(), 1);
        }
        return ();
    }

    if (op == op::transfer) {
        slice to_address = in_msg_body~load_msg_addr();
        slice response_address = in_msg_body~load_msg_addr();
        int amount = in_msg_body~load_coins();
        int forward_ton_amount = in_msg_body~load_coins();

        throw_unless(402, slice_hash(sender_address) == slice_hash(owner_address));
        throw_unless(403, balance >= amount);

        balance = balance - amount;

        set_data(begin_cell()
            .store_coins(balance)
            .store_slice(owner_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .end_cell());

        slice receiver_wallet = begin_cell()
            .store_uint(0, 2)
            .store_slice(to_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .end_cell()
            .begin_parse();

        cell transfer_body = begin_cell()
            .store_uint(op::internal_transfer, 32)
            .store_uint(query_id, 64)
            .store_coins(amount)
            .store_slice(owner_address)
            .store_slice(response_address)
            .store_coins(forward_ton_amount)
            .store_uint(0, 1)
            .end_cell();

        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(receiver_wallet)
            .store_coins(msg_value)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
            .store_ref(transfer_body)
            .end_cell(), 1);
        return ();
    }

    if (op == op::burn) {
        int amount = in_msg_body~load_coins();
        slice response_address = in_msg_body~load_msg_addr();

        throw_unless(404, slice_hash(sender_address) == slice_hash(owner_address));
        throw_unless(405, balance >= amount);

        balance = balance - amount;

        set_data(begin_cell()
            .store_coins(balance)
            .store_slice(owner_address)
            .store_slice(jetton_master_address)
            .store_ref(jetton_wallet_code)
            .end_cell());

        cell burn_body = begin_cell()
            .store_uint(op::burn_notification, 32)
            .store_uint(query_id, 64)
            .store_coins(amount)
            .store_slice(owner_address)
            .store_slice(response_address)
            .end_cell();

        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(jetton_master_address)
            .store_coins(msg_value)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
            .store_ref(burn_body)
            .end_cell(), 1);
        return ();
    }

    return ();
}
int get_wallet_balance() method_id {
    slice ds = get_data().begin_parse();
    return ds~load_coins();
}

slice get_wallet_owner() method_id {
    slice ds = get_data().begin_parse();
    ds~load_coins();
    return ds~load_msg_addr();
}

slice get_wallet_master() method_id {
    slice ds = get_data().begin_parse();
    ds~load_coins();
    ds~load_msg_addr();
    return ds~load_msg_addr();
}

cell get_wallet_code() method_id {
    slice ds = get_data().begin_parse();
    ds~load_coins();
    ds~load_msg_addr();
    ds~load_msg_addr();
    return ds~load_ref();
}
